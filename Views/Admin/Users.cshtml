@model IEnumerable<FindFootballOppsite.Models.User>
@{
    ViewData["Title"] = "Quản lý Người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);
    var search = ViewBag.Search as string ?? "";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="ff-toast"><i class="ti ti-circle-check"></i> @TempData["SuccessMessage"]</div>
}

<!-- Page Header -->
<div class="ff-dashboard-hero ff-animate-in">
  <h2><i class="ti ti-users"></i> Quản Lý Người Dùng</h2>
  <p>Quản lý tài khoản, phân quyền và theo dõi người dùng trên hệ thống.</p>
</div>

<!-- Toolbar -->
<div class="ff-toolbar ff-animate-in">
  <form method="get" asp-action="Users" class="ff-search-box">
    <i class="ti ti-search ff-search-icon"></i>
    <input type="text" name="search" value="@search" placeholder="Tìm theo tên, username hoặc SĐT..." />
  </form>
  <div class="ff-toolbar-actions">
    <span class="ff-badge ff-badge-primary ff-badge-pill">@totalItems người dùng</span>
    <a href="@Url.Action("CreateUser", "Admin")" class="ff-btn ff-btn-primary"><i class="ti ti-plus"></i> Thêm mới</a>
  </div>
</div>

<!-- Table Card -->
<div class="ff-card ff-animate-in" style="height:auto;">
  <div class="ff-card-body" style="padding:0;">
    @if (Model.Any())
    {
      <div class="table-responsive">
        <table class="ff-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Người dùng</th>
              <th>SĐT</th>
              <th>Vai trò</th>
              <th>Ngày tạo</th>
              <th style="text-align:right;">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var user in Model)
            {
              <tr>
                <td><span class="ff-badge ff-badge-primary">#@user.UserId</span></td>
                <td>
                  <div style="display:flex;align-items:center;gap:10px;">
                    <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#8b5cf6);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.78rem;flex-shrink:0;">
                      @(user.FullName?.Length > 0 ? user.FullName.Substring(0, 1).ToUpper() : "?")
                    </div>
                    <div>
                      <div style="font-weight:600;font-size:0.88rem;">@user.FullName</div>
                      <div style="font-size:0.78rem;color:var(--ff-text-muted);">@user.Username</div>
                    </div>
                  </div>
                </td>
                <td>@(user.Phone ?? "—")</td>
                <td>
                  @if (user.Roles != null && user.Roles.Any())
                  {
                    @foreach (var r in user.Roles)
                    {
                      var cls = r.RoleName == "Admin" ? "danger" : r.RoleName == "Captain" ? "purple" : r.RoleName == "StadiumOwner" ? "warning" : "info";
                      <span class="ff-badge ff-badge-@cls me-1">@r.RoleName</span>
                    }
                  }
                  else
                  {
                    <span class="ff-badge ff-badge-primary" style="opacity:.4;">Chưa gán</span>
                  }
                </td>
                <td style="font-size:0.82rem;color:var(--ff-text-muted);">@(user.CreatedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                <td style="text-align:right;">
                  <div style="display:flex;gap:6px;justify-content:flex-end;">
                    <a href="@Url.Action("EditUserRole", "Admin", new { id = user.UserId })" class="ff-btn ff-btn-info ff-btn-sm" title="Phân quyền"><i class="ti ti-key"></i></a>
                    <a href="@Url.Action("EditUser", "Admin", new { id = user.UserId })" class="ff-btn ff-btn-warning ff-btn-sm" title="Sửa"><i class="ti ti-edit"></i></a>
                    <a href="@Url.Action("DeleteUser", "Admin", new { id = user.UserId })" class="ff-btn ff-btn-danger ff-btn-sm" title="Xóa" onclick="return confirm('Bạn có chắc chắn muốn xóa người dùng này?');"><i class="ti ti-trash"></i></a>
                  </div>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      @if (totalPages > 1)
      {
        <div class="ff-pagination" style="padding:12px 20px;">
          <div class="ff-pagination-info">Trang @currentPage / @totalPages · @totalItems kết quả</div>
          <div class="ff-pagination-pages">
            <a href="@Url.Action("Users", "Admin", new { search, page = currentPage - 1 })" class="@(currentPage <= 1 ? "disabled" : "")"><i class="ti ti-chevron-left"></i></a>
            @for (int i = 1; i <= totalPages; i++)
            {
              if (i == currentPage)
              {
                <span class="active">@i</span>
              }
              else
              {
                <a href="@Url.Action("Users", "Admin", new { search, page = i })">@i</a>
              }
            }
            <a href="@Url.Action("Users", "Admin", new { search, page = currentPage + 1 })" class="@(currentPage >= totalPages ? "disabled" : "")"><i class="ti ti-chevron-right"></i></a>
          </div>
        </div>
      }
    }
    else
    {
      <div class="ff-empty-state">
        <i class="ti ti-users-minus"></i>
        <p>Không tìm thấy người dùng nào@(string.IsNullOrEmpty(search) ? "" : $" cho từ khóa \"{search}\"")</p>
      </div>
    }
  </div>
</div>
