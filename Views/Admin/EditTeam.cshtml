@model FindFootballOppsite.Models.Team
@{
    ViewData["Title"] = "Sửa Đội bóng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="ff-dashboard-hero ff-animate-in" style="background:linear-gradient(135deg,#059669,#0891b2);">
  <h2><i class="ti ti-shield-check"></i> Sửa Thông Tin Đội Bóng</h2>
  <p>Cập nhật đội bóng #@Model.TeamId — @Model.TeamName</p>
</div>

<a href="@Url.Action("Teams", "Admin")" class="ff-btn ff-btn-outline mb-3 ff-animate-in"><i class="ti ti-arrow-left"></i> Quay lại danh sách</a>

<div class="ff-form-card ff-animate-in">
  <div class="ff-card-header"><h5><i class="ti ti-shield-check"></i> Chỉnh sửa thông tin</h5></div>
  <div class="ff-card-body">
    <form asp-action="EditTeam" method="post">
      <input type="hidden" asp-for="TeamId" />
      <input type="hidden" asp-for="CreatedAt" />
      <div class="ff-form-group">
        <label asp-for="TeamName">Tên Đội bóng <span style="color:var(--ff-danger);">*</span></label>
        <input asp-for="TeamName" required />
      </div>
      <div class="ff-form-group">
        <label asp-for="CaptainId">ID Đội trưởng</label>
        <input asp-for="CaptainId" type="number" />
      </div>
      <div class="ff-form-group">
        <label asp-for="QualityLevel">Trình độ</label>
        <select asp-for="QualityLevel">
          <option value="">— Chọn trình độ —</option>
          <option value="Gà">Gà (Mới chơi)</option>
          <option value="Trung bình">Trung bình</option>
          <option value="Khá">Khá</option>
          <option value="Giỏi">Giỏi</option>
        </select>
      </div>
      <div class="ff-form-group">
        <label asp-for="History">Mô tả đội</label>
        <textarea asp-for="History" rows="3"></textarea>
      </div>
      <div class="ff-form-group">
        <label>Trạng thái</label>
        <div class="ff-check">
          <input asp-for="IsDisbanded" type="checkbox" />
          <span>Đã giải tán</span>
        </div>
      </div>
      <div style="display:flex;gap:10px;padding-top:8px;">
        <button type="submit" class="ff-btn ff-btn-success ff-btn-lg"><i class="ti ti-check"></i> Cập nhật</button>
        <a href="@Url.Action("Teams", "Admin")" class="ff-btn ff-btn-outline ff-btn-lg">Hủy</a>
      </div>
    </form>
  </div>
</div>
