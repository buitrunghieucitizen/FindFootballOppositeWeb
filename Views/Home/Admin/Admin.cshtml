@model PortalHubViewModel
@{
    ViewData["Title"] = "Trang Quản Trị Viên";
    Layout = "_AdminLayout";
}

<!-- Hero Header -->
<div class="ff-dashboard-hero ff-animate-in">
  <h2><i class="ti ti-shield-check"></i> Trung Tâm Điều Hành Hệ Thống</h2>
  <p>Giám sát toàn bộ hoạt động của nền tảng FindFootball — người dùng, đội bóng, sân bóng và nội dung.</p>
  <span class="ff-hero-badge"><span class="ff-live-dot"></span> Hệ thống đang hoạt động</span>
</div>

<!-- Stat Cards Row -->
<div class="row g-3 mb-4">
  <div class="col-md-6 col-xl-3 ff-animate-in">
    <div class="ff-stat-card">
      <div class="ff-stat-icon bg-primary-soft"><i class="ti ti-users"></i></div>
      <div class="ff-stat-value">@Model.Metrics.PlayerCount</div>
      <div class="ff-stat-label">Tổng Người Dùng</div>
      <span class="ff-stat-trend up"><i class="ti ti-trending-up"></i> +2 tuần này</span>
    </div>
  </div>
  <div class="col-md-6 col-xl-3 ff-animate-in">
    <div class="ff-stat-card">
      <div class="ff-stat-icon bg-success-soft"><i class="ti ti-shield"></i></div>
      <div class="ff-stat-value">@Model.Metrics.TeamCount</div>
      <div class="ff-stat-label">Đội Bóng</div>
      <span class="ff-stat-trend up"><i class="ti ti-trending-up"></i> Đang hoạt động</span>
    </div>
  </div>
  <div class="col-md-6 col-xl-3 ff-animate-in">
    <div class="ff-stat-card">
      <div class="ff-stat-icon bg-warning-soft"><i class="ti ti-map-pin"></i></div>
      <div class="ff-stat-value">@Model.Metrics.StadiumCount</div>
      <div class="ff-stat-label">Cụm Sân Bóng</div>
      <span class="ff-stat-trend up"><i class="ti ti-trending-up"></i> @Model.Metrics.PitchCount sân con</span>
    </div>
  </div>
  <div class="col-md-6 col-xl-3 ff-animate-in">
    <div class="ff-stat-card">
      <div class="ff-stat-icon bg-info-soft"><i class="ti ti-calendar-event"></i></div>
      <div class="ff-stat-value">@Model.Metrics.UpcomingMatchCount</div>
      <div class="ff-stat-label">Trận Sắp Diễn Ra</div>
      <span class="ff-stat-trend up"><i class="ti ti-trending-up"></i> @Model.Metrics.ActiveRecruitmentCount tin tuyển</span>
    </div>
  </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
  <div class="col-md-6 col-xl-3 ff-animate-in">
    <a href="@Url.Action("Users", "Admin")" class="ff-quick-action">
      <div class="ff-qa-icon bg-primary-soft"><i class="ti ti-users"></i></div>
      <div class="ff-qa-text">
        <h6>Quản lý Người Dùng</h6>
        <p>Phân quyền & quản lý tài khoản</p>
      </div>
      <i class="ti ti-chevron-right ff-qa-arrow"></i>
    </a>
  </div>
  <div class="col-md-6 col-xl-3 ff-animate-in">
    <a href="@Url.Action("Teams", "Admin")" class="ff-quick-action">
      <div class="ff-qa-icon bg-success-soft"><i class="ti ti-shield"></i></div>
      <div class="ff-qa-text">
        <h6>Quản lý Đội Bóng</h6>
        <p>Giám sát đội & thành viên</p>
      </div>
      <i class="ti ti-chevron-right ff-qa-arrow"></i>
    </a>
  </div>
  <div class="col-md-6 col-xl-3 ff-animate-in">
    <a href="@Url.Action("Stadiums", "Admin")" class="ff-quick-action">
      <div class="ff-qa-icon bg-warning-soft"><i class="ti ti-map-pin"></i></div>
      <div class="ff-qa-text">
        <h6>Quản lý Sân Bóng</h6>
        <p>Cụm sân & báo giá</p>
      </div>
      <i class="ti ti-chevron-right ff-qa-arrow"></i>
    </a>
  </div>
  <div class="col-md-6 col-xl-3 ff-animate-in">
    <a href="@Url.Action("Matches", "Admin")" class="ff-quick-action">
      <div class="ff-qa-icon bg-info-soft"><i class="ti ti-calendar-event"></i></div>
      <div class="ff-qa-text">
        <h6>Quản lý Trận Đấu</h6>
        <p>Kèo đấu & lịch thi đấu</p>
      </div>
      <i class="ti ti-chevron-right ff-qa-arrow"></i>
    </a>
  </div>
</div>

<!-- Main Content Row -->
<div class="row g-3 mb-4">
  <!-- User Table -->
  <div class="col-xl-7 ff-animate-in">
    <div class="ff-card">
      <div class="ff-card-header">
        <h5><i class="ti ti-users"></i> Tài Khoản & Phân Quyền</h5>
        <span class="ff-badge ff-badge-primary ff-badge-pill">@Model.Players.Count người</span>
      </div>
      <div class="ff-card-body" style="padding: 0;">
        <div class="table-responsive">
          <table class="ff-table">
            <thead>
              <tr>
                <th>Họ tên</th>
                <th>Username</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var player in Model.Players)
              {
                <tr>
                  <td>
                    <div style="display:flex;align-items:center;gap:10px;">
                      <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#8b5cf6);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.78rem;">
                        @player.FullName.Substring(0, 1)
                      </div>
                      <span style="font-weight:600;">@player.FullName</span>
                    </div>
                  </td>
                  <td><code style="font-size:0.82rem;">@player.Username</code></td>
                  <td>
                    @foreach (var r in player.Roles)
                    {
                      <span class="ff-badge ff-badge-@(r == "Admin" ? "danger" : r == "Captain" ? "purple" : r == "StadiumOwner" ? "warning" : "primary") me-1">@r</span>
                    }
                  </td>
                  <td><span class="ff-badge ff-badge-success ff-badge-pill"><span class="ff-live-dot" style="width:6px;height:6px;margin-right:4px;"></span> Online</span></td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Teams & Stadiums -->
  <div class="col-xl-5 ff-animate-in">
    <div class="ff-card">
      <div class="ff-card-header">
        <h5><i class="ti ti-shield"></i> Đội Bóng & Sân Bóng</h5>
      </div>
      <div class="ff-card-body">
        <h6 style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;color:var(--ff-text-muted);margin-bottom:12px;">Đội Bóng</h6>
        @foreach (var team in Model.Teams)
        {
          <div class="ff-list-item">
            <div class="ff-list-icon" style="background:linear-gradient(135deg, rgba(16,185,129,0.15), rgba(6,182,212,0.1));color:var(--ff-success);">
              <i class="ti ti-shield-check"></i>
            </div>
            <div class="ff-list-content">
              <h6>@team.TeamName</h6>
              <p>Đội trưởng: @team.CaptainName · @team.QualityLevel · @team.Members.Count thành viên</p>
            </div>
            <span class="ff-badge ff-badge-success ff-badge-pill">@(team.LookingForOpponent ? "Đang tìm kèo" : "Đang ổn")</span>
          </div>
        }

        <h6 style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;color:var(--ff-text-muted);margin-bottom:12px;margin-top:20px;">Sân Bóng</h6>
        @foreach (var stadium in Model.Stadiums)
        {
          <div class="ff-list-item">
            <div class="ff-list-icon" style="background:linear-gradient(135deg, rgba(245,158,11,0.15), rgba(239,68,68,0.1));color:var(--ff-warning);">
              <i class="ti ti-map-pin"></i>
            </div>
            <div class="ff-list-content">
              <h6>@stadium.StadiumName</h6>
              <p>Chủ sân: @stadium.OwnerName · @stadium.Address</p>
              <div class="ff-progress-bar" style="width:70%;">
                <div class="ff-progress-fill fill-success" style="width:78%;"></div>
              </div>
              <span style="font-size:0.72rem;color:var(--ff-text-muted);">@stadium.UtilizationLabel</span>
            </div>
          </div>
        }
      </div>
    </div>
  </div>
</div>

<!-- Notifications & Moderation Row -->
<div class="row g-3 mb-4">
  <div class="col-xl-6 ff-animate-in">
    <div class="ff-card">
      <div class="ff-card-header">
        <h5><i class="ti ti-bell-ringing"></i> Thông Báo Hệ Thống</h5>
        <span class="ff-badge ff-badge-danger ff-badge-pill">@Model.Notifications.Count mới</span>
      </div>
      <div class="ff-card-body">
        @foreach (var notif in Model.Notifications)
        {
          <div class="ff-list-item">
            <div class="ff-list-icon" style="background:linear-gradient(135deg, rgba(37,99,235,0.15), rgba(139,92,246,0.1));color:var(--ff-primary);">
              <i class="ti ti-bell"></i>
            </div>
            <div class="ff-list-content">
              <h6>@notif.Title</h6>
              <p>Gửi tới: <strong>@notif.RecipientName</strong> — @notif.Message</p>
            </div>
          </div>
        }
      </div>
    </div>
  </div>

  <div class="col-xl-6 ff-animate-in">
    <div class="ff-card">
      <div class="ff-card-header">
        <h5><i class="ti ti-speakerphone"></i> Kiểm Duyệt Tuyển Quân</h5>
        <span class="ff-badge ff-badge-warning ff-badge-pill">@Model.RecruitmentAds.Count bài đăng</span>
      </div>
      <div class="ff-card-body">
        @foreach (var ad in Model.RecruitmentAds)
        {
          <div class="ff-list-item">
            <div class="ff-list-icon" style="background:linear-gradient(135deg, rgba(245,158,11,0.15), rgba(239,68,68,0.1));color:var(--ff-warning);">
              <i class="ti ti-speakerphone"></i>
            </div>
            <div class="ff-list-content">
              <h6>@ad.Title</h6>
              <p>Đội: <strong>@ad.TeamName</strong> · Vị trí: @ad.PositionNeeded</p>
              <span class="ff-badge ff-badge-danger mt-1">@ad.UrgencyLabel</span>
            </div>
          </div>
        }
      </div>
    </div>
  </div>
</div>
